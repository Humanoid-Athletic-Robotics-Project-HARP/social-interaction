<!-- Level 3: walls between two side walls force a slalom: through a 1.6 m gap
     on the left, then one on the right, then a 1.3 m gate. Goal 7.5 m ahead.
     submission/sim.sh --world slalom -->
<mujoco>
  <default>
    <default class="obstacle">
      <geom type="box" rgba="0.8 0.5 0.2 1"/>
    </default>
  </default>
  <worldbody>
    <geom class="obstacle" name="side_left" size="3.85 0.1 0.5" pos="4.85 2.1 0.5"/>
    <geom class="obstacle" name="side_right" size="3.85 0.1 0.5" pos="4.85 -2.1 0.5"/>
    <!-- 1.6 m gaps: left of the first wall, right of the second -->
    <geom class="obstacle" name="wall_1" size="0.1 1.2 0.5" pos="2.2 -0.8 0.5"/>
    <geom class="obstacle" name="wall_2" size="0.1 1.2 0.5" pos="4.2 0.8 0.5"/>
    <!-- a 1.3 m gate in the middle -->
    <geom class="obstacle" name="gate_left" size="0.1 0.675 0.5" pos="6.2 1.325 0.5"/>
    <geom class="obstacle" name="gate_right" size="0.1 0.675 0.5" pos="6.2 -1.325 0.5"/>
    <!-- closes the far end, so the course can't be walked around -->
    <geom class="obstacle" name="end_wall" size="0.1 2.2 0.5" pos="8.7 0 0.5"/>
    <site name="goal" pos="7.5 0 0.01" size="0.15 0.01" type="cylinder" rgba="0.2 0.8 0.3 0.6"/>
  </worldbody>
</mujoco>
