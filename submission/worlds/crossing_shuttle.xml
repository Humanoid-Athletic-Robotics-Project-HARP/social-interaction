<!-- Kept only so the runs recorded with it (2026-10-27) can still be
     summarized: the old crossing test, which has no pass criteria. A person
     walks back and forth across the
     robot's path, 2.5 m ahead, at about 1.2 m/s (5 m in 4.2 s each way),
     from sim time 0. Goal 5 m ahead. How movers work: submission/harp/movers.py.
     submission/sim.sh --world crossing_shuttle -->
<mujoco>
  <custom>
    <numeric name="person_duration" data="4.2"/>
  </custom>
  <worldbody>
    <!-- About shoulder-wide and 1.7 m tall, standing just off the floor -->
    <body name="person" mocap="true" pos="2.5 -2.5 0">
      <geom name="person" type="cylinder" size="0.25 0.85" pos="0 0 0.86" rgba="0.3 0.4 0.8 1"/>
    </body>
    <site name="person_end" pos="2.5 2.5 0"/>
    <site name="goal" pos="5 0 0.01" size="0.15 0.01" type="cylinder" rgba="0.2 0.8 0.3 0.6"/>
  </worldbody>
</mujoco>
