# Third-party code we build against but don't commit. Not needed yet: the
# skeleton runs on plain ROS 2. Fetch these on the Jetson once robot_bridge
# talks to real hardware:
#   vcs import deps < dependencies.repos
repositories:
  unitree_sdk2_python:
    type: git
    url: https://github.com/unitreerobotics/unitree_sdk2_python.git
    version: master
  unitree_ros2:
    type: git
    url: https://github.com/unitreerobotics/unitree_ros2.git
    version: master
