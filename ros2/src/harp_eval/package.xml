<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harp_eval</name>
  <version>0.1.0</version>
  <description>
    Course tests and run logging for the G1. course runs a course in the sim
    with walker_node and Nav2 (harp_ros); run_recorder records any run;
    runs lists, compares and checks runs against each course's criteria.
  </description>
  <maintainer email="todo@todo.todo">HARP Human Interaction team</maintainer>
  <license>TODO</license>

  <exec_depend>harp_control</exec_depend>
  <exec_depend>harp_ros</exec_depend>
  <exec_depend>harp_sim</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
