<!--
  Nav2's navigate_to_pose_w_replanning_and_recovery.xml (Jazzy) without its
  costmap clearing and BackUp: replan at 1 Hz, follow the path, and when stuck,
  turn in place or wait, then try again.
  Clearing the costmaps would forget obstacles in the lidar's blind ring near
  the feet, which it can't see again until it steps back from them; backing
  up is risky for a walking robot.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
                             error_code_id="{compute_path_error_code}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Wait wait_duration="3.0"/>
          <Spin spin_dist="0.8" error_code_id="{spin_error_code}"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
