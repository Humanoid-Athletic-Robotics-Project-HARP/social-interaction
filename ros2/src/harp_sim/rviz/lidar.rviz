# rviz2 view of the head lidar: ros2 run rviz2 rviz2 -d <this file> (see README).
# Points are colored by height; the axes are base_link, on the floor under the robot.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: base_link
      Cell Size: 1
      Plane Cell Count: 12
    - Class: rviz_default_plugins/Axes
      Name: base_link
      Enabled: true
      Reference Frame: base_link
      Length: 0.5
      Radius: 0.02
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /utlidar/cloud_livox_mid360
      Style: Points
      Size (Pixels): 4
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      # Fixed bounds, so the floor is one color and anything standing on it another.
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 1.5
  Global Options:
    Fixed Frame: base_link
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Pitch: 0.75
      Yaw: 3.4
      Focal Point:
        X: 1
        Y: 0
        Z: 0
