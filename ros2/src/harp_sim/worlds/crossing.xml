<!-- Moving obstacles, level 1: a person crosses the robot's path once,
     2.5 m ahead, from right to left at 1.2 m/s (6 m in 5 s), then stands
     3 m to the side. They start 3 s after the robot starts walking, so they
     cross its line when it is about 1 m away from them. Goal 5 m ahead. How
     movers work: harp_sim/movers.py.
     ros2 run harp_sim run_sim --lidar --world crossing -->
<mujoco>
  <custom>
    <numeric name="person_duration" data="5"/>
    <numeric name="person_delay" data="3"/>
    <numeric name="person_trips" data="1"/>
  </custom>
  <worldbody>
    <!-- About shoulder-wide and 1.7 m tall, standing just off the floor -->
    <body name="person" mocap="true" pos="2.5 -3 0">
      <geom name="person" type="cylinder" size="0.25 0.85" pos="0 0 0.86" rgba="0.3 0.4 0.8 1"/>
    </body>
    <site name="person_end" pos="2.5 3 0"/>
    <site name="goal" pos="5 0 0.01" size="0.15 0.01" type="cylinder" rgba="0.2 0.8 0.3 0.6"/>
  </worldbody>
</mujoco>
