<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>harp_sim</name>
  <version>0.1.0</version>
  <description>
    MuJoCo sim of the 29-joint G1 that speaks the robot's low-level DDS topics
    (rt/lowstate, rt/lowcmd), for testing our controllers before the robot.
  </description>
  <maintainer email="todo@todo.todo">HARP Human Interaction team</maintainer>
  <license>TODO</license>

  <!-- Python dependencies (numpy, mujoco, unitree_sdk2py) come from
       ros2/pixi.toml, not rosdep. ROS 2 is for the simulated lidar and for
       run logging (true pose, events); harp_control for where the lidar
       sits (lidar_mount) and for events (runlog). -->
  <exec_depend>harp_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
